# Unreal binaries go through Git LFS. The website and the browser game (web/) stay as plain files so
# GitHub Pages can serve them directly.
MidnightCourier/**/*.uasset filter=lfs diff=lfs merge=lfs -text
MidnightCourier/**/*.umap filter=lfs diff=lfs merge=lfs -text
MidnightCourier/**/*.ttf filter=lfs diff=lfs merge=lfs -text
